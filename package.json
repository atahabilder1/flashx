{
  "name": "flashx",
  "version": "1.0.0",
  "description": "Aave V3 Flash Loan Simulator - A full-stack dApp demonstrating flash loans with Chainlink price feeds",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.ts",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "simulate": "hardhat run scripts/simulateFlashLoan.ts --network sepolia",
    "node": "hardhat node",
    "lint": "solhint 'contracts/**/*.sol'",
    "typecheck": "tsc --noEmit",
    "clean": "hardhat clean"
  },
  "keywords": [
    "defi",
    "flashloan",
    "aave",
    "chainlink",
    "ethereum",
    "solidity",
    "hardhat"
  ],
  "author": "Anik Tahabilder",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.2",
    "@nomicfoundation/hardhat-ethers": "^3.0.4",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.9",
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^1.1.1",
    "@typechain/ethers-v6": "^0.4.3",
    "@typechain/hardhat": "^8.0.3",
    "@types/chai": "^4.3.6",
    "@types/mocha": "^10.0.2",
    "@types/node": "^20.5.9",
    "chai": "^4.3.8",
    "ethers": "^6.7.1",
    "hardhat": "^2.17.2",
    "hardhat-gas-reporter": "^1.0.9",
    "solhint": "^4.0.0",
    "solidity-coverage": "^0.8.4",
    "ts-node": "^10.9.1",
    "typechain": "^8.3.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@aave/core-v3": "^1.19.1",
    "@chainlink/contracts": "^0.8.0",
    "@openzeppelin/contracts": "^4.9.3",
    "dotenv": "^16.3.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}